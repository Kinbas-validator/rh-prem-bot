# RH_PREM_BOT_MANAGED_SERVICE
[Unit]
Description=Lighter Robinhood RWA Premium Telegram Monitor
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=rh-prem-bot
Group=rh-prem-bot
WorkingDirectory=/opt/rh-prem-bot/current
ExecStart=/opt/rh-prem-bot/current/.venv/bin/python -m rh_prem_bot --env-file /etc/rh-prem-bot/bot.env run
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
CPUAccounting=true
CPUWeight=20
CPUQuota=50%
MemoryAccounting=true
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=64M
TasksMax=64
IOWeight=20
Nice=10
OOMScoreAdjust=500
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rh-prem-bot

[Install]
WantedBy=multi-user.target
