# Получить у @BotFather. Для monitor/demo/doctor не нужен.
TELEGRAM_BOT_TOKEN=
# Числовые ID получателей через запятую. Личный чат рекомендуется.
TELEGRAM_CHAT_IDS=
# Кто может менять настройки. Для личного чата совпадает с chat ID.
TELEGRAM_ADMIN_IDS=

# Пусто = все активные RWA по категориям ниже. Пример: OPENAI,NVDA,TSLA
MARKETS=
MARKET_TYPES=perp
# Пусто = весь раздел RWA, включая ETF и сырьё.
RWA_CATEGORIES=STOCK,PRE_IPO
WINDOW_SECONDS=60
BASELINE_MINUTES=30
WARMUP_MINUTES=10
SPIKE_MULTIPLIER=3
MIN_PREMIUM_USD=10000
MIN_PREMIUM_SHARE=0.5
MIN_PREMIUM_ACCOUNTS=2
# Нижняя граница среднего объёма для расчёта xN; защищает от деления на 0.
BASELINE_FLOOR_USD=1000
COOLDOWN_SECONDS=300
EVALUATION_SECONDS=5
# maker_taker (maker → taker) или seller_buyer (продавец → покупатель)
FLOW_DIRECTION=maker_taker
DB_PATH=data/bot.sqlite3
RETENTION_DAYS=7
ALERT_MAX_AGE_SECONDS=900
LOG_LEVEL=INFO
